import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import random
#Step 2 : Dataset generation

categories = ['Health', 'Family', 'Food', 'Travel',
              'Fitness', 'Technology', 'Education']

n = 1000

data = {
    'Date': pd.date_range(start='2025-01-01', periods=n),
    'Category': [random.choice(categories) for _ in range(n)],
    'Likes': np.random.randint(100, 10000, size=n)
}

df = pd.DataFrame(data)

print(df)
#Step 3 : Dataset exploration

print(df.info())

print(df.describe())

print(df['Category'].value_counts())
#Step 4: Data cleaning
#1. handle missing values
df['Likes'] = df['Likes'].fillna(df['Likes'].mean())

print(df.isnull().sum())

#2. remove duplicates
print("Duplicate rows:", df.duplicated().sum())

df = df.drop_duplicates()

print("Duplicate rows after cleaning:", df.duplicated().sum())

#3. Fix Data Types & Formats
print(df.dtypes)

df['Date'] = pd.to_datetime(df['Date'])

df['Likes'] = pd.to_numeric(df['Likes'])

print(df.dtypes)


#4. remove outliers 
Q1 = df['Likes'].quantile(0.25)
Q3 = df['Likes'].quantile(0.75)

IQR = Q3 - Q1

lower = Q1 - 1.5 * IQR
upper = Q3 + 1.5 * IQR

print("Lower Limit:", lower)
print("Upper Limit:", upper)
df = df[(df['Likes'] >= lower) & (df['Likes'] <= upper)]
print(df.shape)

#6. Final cleaned dataset
print(df.info())
print(df.head())
print(df.describe())
avg_likes = df.groupby('Category')['Likes'].mean()

print(avg_likes)
popular = df.groupby('Category')['Likes'].sum()

print(popular)
#Step 5 : Data Visualization 
